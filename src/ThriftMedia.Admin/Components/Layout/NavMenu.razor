<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ThriftMedia Admin</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView Policy="@AdminPolicies.StoreMember">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="store">
                    <span class="bi bi-shop" aria-hidden="true"></span> My store
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="media">
                    <span class="bi bi-collection-fill" aria-hidden="true"></span> Media
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@AdminPolicies.SystemAdmin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="system">
                    <span class="bi bi-gear-fill" aria-hidden="true"></span> System
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <form method="post" action="/signout">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link btn btn-link">Sign out</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="signin">Sign in</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
