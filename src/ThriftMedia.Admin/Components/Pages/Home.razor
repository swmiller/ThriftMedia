@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-4">
    <h1>ThriftMedia Admin Portal</h1>

    <AuthorizeView>
        <Authorized>
            <p class="lead">Signed in as @(context.User.Identity?.Name ?? "your account").</p>
            <div class="d-flex gap-2">
                <AuthorizeView Policy="@AdminPolicies.StoreMember" Context="store">
                    <a href="/store" class="btn btn-primary">My store</a>
                    <a href="/media" class="btn btn-outline-primary">Media</a>
                </AuthorizeView>
                <AuthorizeView Policy="@AdminPolicies.SystemAdmin" Context="sys">
                    <a href="/system" class="btn btn-primary">System administration</a>
                </AuthorizeView>
            </div>
        </Authorized>
        <NotAuthorized>
            <p class="lead">Sign in to manage your store.</p>
            <SignInButtons />
        </NotAuthorized>
    </AuthorizeView>
</div>
